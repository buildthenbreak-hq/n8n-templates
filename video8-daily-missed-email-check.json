      "alwaysOutputData": true,
      "credentials": {
        "gmailOAuth2": {
          "id": null,
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(j => j.id);\nif (!rows.length) {\n  return [{ json: { subject: 'Inbox check: nothing skipped yesterday', body: 'Every inbox email from the last day has the AI Processed label.' } }];\n}\nconst lines = rows.map(j => `- ${j.Subject || j.subject || '(no subject)'}  |  ${j.From || (j.from && j.from.text) || ''}`);\nreturn [{ json: {\n  subject: `Inbox check: ${rows.length} email(s) the assistant skipped`,\n  body: `These inbox emails from the last day have no AI Processed label:\\n\\n${lines.join('\\n')}\\n\\nGmail search: in:inbox -label:ai-processed newer_than:1d`\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "d139adc1-f5b8-45b2-9516-557c50ddbde1",
      "name": "Build the list"
    },
    {
