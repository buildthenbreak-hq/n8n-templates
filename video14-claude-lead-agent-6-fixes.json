                "values": [
                  {
                    "option": "Under $500"
                  },
                  {
                    "option": "$500 - $2,000"
                  },
                  {
                    "option": "$2,000 - $10,000"
                  },
                  {
                    "option": "Over $10,000"
                  }
                ]
              },
