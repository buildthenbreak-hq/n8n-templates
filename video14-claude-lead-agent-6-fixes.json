        0,
        0
      ],
      "webhookId": "b7c3e9a0-2222-4d1e-8f02-000000000002"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Rate this sales lead.\n\nName: {{ $json.Name }}\nEmail: {{ $json.Email }}\nCompany: {{ $json.Company }}\nBudget: {{ $json.Budget }}\nMessage: {{ $json.Message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a sales assistant that qualifies inbound leads for a small business.\n\nRate each lead as exactly one of: Hot, Warm, Cold.\n- Hot: clear need, budget of $2,000 or more, wants to start soon or asks for a call or quote.\n- Warm: real interest but low budget, vague timing or missing details.\n- Cold: spam, students, job seekers, vendors selling to us, or no real need.\n\nGive one short sentence explaining the rating. Use only the information in the form. Do not invent facts."
        }
      },
      "id": "a1f0c2d4-1111-4a6b-9c01-000000000003",
      "name": "Rate Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-flash-lite-latest",
        "options": {
